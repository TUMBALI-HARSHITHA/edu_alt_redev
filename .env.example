# Server-side only (NEVER prefix with VITE_)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
RAZORPAY_KEY_SECRET=your-razorpay-secret-here
RESEND_API_KEY=re_your-resend-key-here

# Client-safe (VITE_ prefix exposes to browser bundle)
VITE_OPENROUTER_MODEL=z-ai/glm-4.5-air:free
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_RAZORPAY_KEY_ID=rzp_live_your_key_id

# Google Drive (used client-side for resource listing)
VITE_GOOGLE_DRIVE_API_KEY=your-drive-api-key
VITE_GOOGLE_DRIVE_ROOT_FOLDER_ID=your-folder-id
